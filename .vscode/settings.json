{
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/dist/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true,
    "**/dist": true
  },
  "dotnet.defaultSolution": "McpTrackTokens.sln",
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.workingDirectories": [
    {
      "directory": "src/McpTrackTokens.Dashboard",
      "changeProcessCWD": true
    },
    {
      "directory": "integrations/cursor-hooks",
      "changeProcessCWD": true
    }
  ]
}
