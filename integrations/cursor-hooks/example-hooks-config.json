{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "./mcp-track-tokens-hooks/dist/prompt-submitted.js",
        "timeout": 5
      }
    ],
    "sessionStart": [
      {
        "command": "./mcp-track-tokens-hooks/dist/session-started.js",
        "timeout": 5
      }
    ],
    "sessionEnd": [
      {
        "command": "./mcp-track-tokens-hooks/dist/session-ended.js",
        "timeout": 5
      }
    ],
    "subagentStart": [
      {
        "command": "./mcp-track-tokens-hooks/dist/agent-started.js",
        "timeout": 5
      }
    ],
    "subagentStop": [
      {
        "command": "./mcp-track-tokens-hooks/dist/agent-completed.js",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "./mcp-track-tokens-hooks/dist/agent-completed.js",
        "timeout": 5
      }
    ]
  }
}
