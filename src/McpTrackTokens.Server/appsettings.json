{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tracking": {
    "DatabaseProvider": "Sqlite",
    "DatabasePath": "~/.mcp-track-tokens/mcp-track-tokens.db",
    "ServerUrl": "http://127.0.0.1:5187",
    "BindAddress": "http://127.0.0.1:5187",
    "ExportPath": "~/.mcp-track-tokens/exports/",
    "LogPath": "~/.mcp-track-tokens/logs/",
    "LogLevel": "Information",
    "DefaultCurrency": "USD",
    "InactivityThresholdMinutes": 15,
    "EnableHttpMcp": false,
    "AutoCreateProjects": false,
    "StorePromptContent": false,
    "StoreResponseContent": false,
    "EnablePromptHashing": true,
    "MaxMetadataBytes": 16384,
    "CursorSubscriptionAmount": 0,
    "CursorSubscriptionCurrency": "USD",
    "CursorAllocationMethod": "NotAllocated",
    "EncryptionKeyPath": "~/.mcp-track-tokens/encryption.key",
    "QueuePath": "~/.mcp-track-tokens/queue/",
    "MaxQueuedEvents": 10000,
    "MaxRequestBytes": 1048576,
    "MigrateOnStartup": false
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "HttpStatusCode": 429,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "GeneralRules": [
      {
        "Endpoint": "*:/api/v1/events*",
        "Period": "1m",
        "Limit": 120
      },
      {
        "Endpoint": "*:/api/v1/sessions*",
        "Period": "1m",
        "Limit": 60
      }
    ]
  },
  "IpRateLimitPolicies": {
    "IpRules": []
  }
}
